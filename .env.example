# Telegram user API credentials (required for Telethon collection)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELETHON_SESSION_STRING=

# Gemini analysis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional private Telegram command bot (not required for on-demand GitHub Actions)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

DATABASE_PATH=data/legion_osint.sqlite3
COLLECT_LIMIT_PER_CHANNEL=300
REPORT_TIMEZONE=Asia/Dhaka
LOG_LEVEL=INFO
